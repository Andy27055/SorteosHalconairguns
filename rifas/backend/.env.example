NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
DATABASE_URL=postgresql://halcon:halcon_local@localhost:5432/halcon
# Conservar estos valores inicialmente; ajustar con mediciones del alojamiento.
DB_POOL_MAX=10
RECEIPT_MAX_CONCURRENT=4
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
# Credenciales sólo en servidor. Dejar vacío deshabilita Mercado Pago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
# Habilita transferencia sólo cuando hay titular y alias o CBU/CVU.
TRANSFER_HOLDER=
TRANSFER_ALIAS=
TRANSFER_CBU=
# Segunda cuenta opcional para transferencias.
TRANSFER_HOLDER_2=
TRANSFER_ALIAS_2=
TRANSFER_CBU_2=
# Opcional: ruta absoluta del volumen privado de comprobantes.
RECEIPT_STORAGE_PATH=
# Sólo para crear inicialmente la cuenta administradora; retirar luego del seed.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=false
DEMO_EMAIL=
DEMO_PASSWORD=
# Correo de confirmación. Mantener deshabilitado hasta configurar el remitente.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
