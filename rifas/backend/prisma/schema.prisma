generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
}
enum AdminType {
  PRIMARY
  FUNCTIONAL
}
enum RaffleStatus {
  DRAFT
  ACTIVE
  CLOSING
  FINISHED
  CANCELLED
}
enum OrderStatus {
  RESERVED
  PAYMENT_PENDING
  AWAITING_RECEIPT
  UNDER_REVIEW
  PAID
  REJECTED
  CANCELLED
  EXPIRED
  NEEDS_ATTENTION
  REFUND_PENDING
  REFUNDED
}
enum PaymentMethod {
  MERCADO_PAGO
  TRANSFER
}
model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  fullName String
  firstName String?
  lastName String?
  dni String?
  address String?
  passwordHash String
  role Role @default(USER)
  adminType AdminType?
  tokenVersion Int @default(0)
  active Boolean @default(true)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  orders Order[]
  verifications EmailVerification[]
}
model Prize {
  id String @id @default(cuid())
  name String
  description String @default("")
  createdAt DateTime @default(now())
  raffles Raffle[]
}
model Raffle {
  id String @id @default(cuid())
  title String
  description String @default("")
  prizeId String
  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  ticketPriceCents Int
  totalTickets Int
  numberStart Int @default(0)
  lotteryDigits Int? @default(2)
  lotteryResult Json?
  winnerOrderId String?
  winnerDisplayName String?
  status RaffleStatus @default(DRAFT)
  drawAt DateTime?
  winnerNumber Int?
  drawnAt DateTime?
  closingAt DateTime?
  resultDate String?
  closedEarly Boolean @default(false)
  closingNote String?
  cancelledAt DateTime?
  cancellationReason String?
  cancellationBuyers Json?
  createdAt DateTime @default(now())
  orders Order[]
  allocations Allocation[]
  notifications RaffleEmail[]
  @@index([status, drawAt])
}
enum RaffleEmailKind {
  RAFFLE_CANCELLED
  RAFFLE_EARLY_CLOSURE
  RAFFLE_RESULT_ADMIN
}
model RaffleEmail {
  id String @id @default(cuid())
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  eventKey String @unique
  kind RaffleEmailKind
  toEmail String
  adminUserId String?
  payload Json
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
}
model LotteryDraw {
  date String @id
  payload Json
  createdAt DateTime @default(now())
}
model Order {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestTokenHash String? @unique
  guestClientHash String?
  buyerEmail String?
  buyerFirstName String?
  buyerLastName String?
  buyerDni String?
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  numbers Int[]
  unitPriceCents Int
  amountCents Int
  status OrderStatus @default(RESERVED)
  method PaymentMethod?
  transferAccountId String?
  transferHolder String?
  transferAlias String?
  transferCbu String?
  expiresAt DateTime
  preferenceId String? @unique
  checkoutUrl String?
  paymentId String? @unique
  legacyReference String? @unique
  paymentStatus String?
  paymentCreatingAt DateTime?
  decisionNote String?
  paidAt DateTime?
  reviewedBy String?
  rejectionReasonCode String?
  refundRequestedAt DateTime?
  refundCompletedAt DateTime?
  refundAmountCents Int?
  refundReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  allocations Allocation[]
  receipts Receipt[]
  emails PurchaseEmail[]
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([guestClientHash, status, expiresAt])
}
enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}
enum OrderEmailKind {
  RAFFLE_WINNER
  PURCHASE_CONFIRMED
  PURCHASE_REJECTED
  REFUND_REQUESTED
  REFUND_COMPLETED
}
model PurchaseEmail {
  id String @id @default(cuid())
  orderId String
  eventKey String @unique
  kind OrderEmailKind @default(PURCHASE_CONFIRMED)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  toEmail String
  payload Json
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([orderId])
}
model Allocation {
  id String @id @default(cuid())
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  number Int
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([raffleId, number])
}
model Receipt {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storageKey String @unique
  mimeType String
  size Int
  sha256 String
  uploadedAt DateTime @default(now())
  deleteAfter DateTime
  deletedAt DateTime?
  @@index([deleteAfter, deletedAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actorRole Role?
  action String
  entityId String
  detail Json?
  createdAt DateTime @default(now())
}
model EmailVerification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  email String
  expiresAt DateTime
  consumedAt DateTime?
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  lockedAt DateTime?
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
