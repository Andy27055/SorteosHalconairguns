generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  USER
  ADMIN
}
enum AdminType {
  PRIMARY
  FUNCTIONAL
}
enum RaffleStatus {
  DRAFT
  ACTIVE
  CLOSING
  FINISHED
  CANCELLED
}
enum OrderStatus {
  RESERVED
  PAYMENT_PENDING
  AWAITING_RECEIPT
  UNDER_REVIEW
  PAID
  REJECTED
  CANCELLED
  EXPIRED
  NEEDS_ATTENTION
  REFUND_PENDING
  REFUNDED
}
enum PaymentMethod {
  MERCADO_PAGO
  TRANSFER
  FREE_TICKET
}
enum PrizeKind {
  ITEM
  FREE_TICKET
}
model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  fullName String
  firstName String?
  lastName String?
  dni String?
  address String?
  passwordHash String
  role Role @default(USER)
  adminType AdminType?
  tokenVersion Int @default(0)
  active Boolean @default(true)
  emailVerifiedAt DateTime?
  createdAt DateTime @default(now())
  orders Order[]
  verifications EmailVerification[]
  freeTicketBenefits FreeTicketBenefit[]
}
model Prize {
  id String @id @default(cuid())
  name String
  description String @default("")
  kind PrizeKind @default(ITEM)
  createdAt DateTime @default(now())
  raffles Raffle[]
  awardItems AwardPrize[]
}
model Raffle {
  id String @id @default(cuid())
  title String
  description String @default("")
  prizeId String
  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  ticketPriceCents Int
  totalTickets Int
  numberStart Int @default(0)
  lotteryDigits Int? @default(2)
  lotteryResult Json?
  winnerOrderId String?
  winnerDisplayName String?
  status RaffleStatus @default(DRAFT)
  drawAt DateTime?
  winnerNumber Int?
  drawnAt DateTime?
  closingAt DateTime?
  resultDate String?
  closedEarly Boolean @default(false)
  closingNote String?
  cancelledAt DateTime?
  cancellationReason String?
  cancellationBuyers Json?
  createdAt DateTime @default(now())
  openedAt DateTime?
  orders Order[]
  allocations Allocation[]
  notifications RaffleEmail[]
  awards RaffleAward[]
  targetedBenefits FreeTicketBenefit[]
  @@index([status, drawAt])
}

model RaffleAward {
  id String @id @default(cuid())
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  rank Int
  winningNumber Int?
  officialNumber String?
  winnerOrderId String?
  winnerOrder Order? @relation("AwardWinner", fields: [winnerOrderId], references: [id], onDelete: Restrict)
  winnerDisplayName String?
  prizes AwardPrize[]
  @@unique([raffleId, rank])
}

model AwardPrize {
  id String @id @default(cuid())
  awardId String
  award RaffleAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  prizeId String
  prize Prize @relation(fields: [prizeId], references: [id], onDelete: Restrict)
  name String
  description String
  quantity Int @default(1)
  kind PrizeKind @default(ITEM)
  benefit FreeTicketBenefit?
  @@unique([awardId, prizeId])
}
enum RaffleEmailKind {
  RAFFLE_CANCELLED
  RAFFLE_EARLY_CLOSURE
  RAFFLE_RESULT_ADMIN
}
model RaffleEmail {
  id String @id @default(cuid())
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  eventKey String @unique
  kind RaffleEmailKind
  toEmail String
  adminUserId String?
  payload Json
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
}
model LotteryDraw {
  date String @id
  payload Json
  createdAt DateTime @default(now())
}
model Order {
  id String @id @default(cuid())
  parentOrderId String?
  parentOrder Order? @relation("PartialRefundOrders",fields:[parentOrderId],references:[id],onDelete:Restrict)
  refundParts Order[] @relation("PartialRefundOrders")
  originalNumbers Int[] @default([])
  originalAmountCents Int?
  refundRequests RefundRequest[] @relation("OrderRefundRequests")
  approvedRefundRequest RefundRequest? @relation("ApprovedRefundOrder")
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestTokenHash String? @unique
  guestClientHash String?
  buyerEmail String?
  buyerFirstName String?
  buyerLastName String?
  buyerDni String?
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  numbers Int[]
  unitPriceCents Int
  amountCents Int
  status OrderStatus @default(RESERVED)
  method PaymentMethod?
  transferAccountId String?
  transferHolder String?
  transferAlias String?
  transferCbu String?
  expiresAt DateTime
  preferenceId String? @unique
  checkoutUrl String?
  paymentId String? @unique
  legacyReference String? @unique
  paymentStatus String?
  paymentCreatingAt DateTime?
  decisionNote String?
  paidAt DateTime?
  reviewedBy String?
  rejectionReasonCode String?
  refundRequestedAt DateTime?
  refundCompletedAt DateTime?
  refundAmountCents Int?
  refundReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  allocations Allocation[]
  receipts Receipt[]
  emails PurchaseEmail[]
  awardsWon RaffleAward[] @relation("AwardWinner")
  freeTicketUses FreeTicketUse[]
  @@index([status, expiresAt])
  @@index([parentOrderId])
  @@index([userId, createdAt])
  @@index([guestClientHash, status, expiresAt])
}
enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
model RefundRequest {
  id String @id @default(cuid())
  orderId String
  order Order @relation("OrderRefundRequests",fields:[orderId],references:[id],onDelete:Restrict)
  numbers Int[]
  amountCents Int
  reason String @default("")
  status RefundRequestStatus @default(PENDING)
  requestKey String @unique
  reviewedBy String?
  reviewedAt DateTime?
  decisionNote String?
  refundOrderId String? @unique
  refundOrder Order? @relation("ApprovedRefundOrder",fields:[refundOrderId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
  @@index([orderId,createdAt])
}
model FreeTicketBenefit {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields:[userId],references:[id],onDelete:Restrict)
  awardPrizeId String? @unique
  awardPrize AwardPrize? @relation(fields:[awardPrizeId],references:[id],onDelete:Restrict)
  grantedBy String?
  reason String?
  grantKey String? @unique
  scope String @default("FUTURE")
  validFrom DateTime @default(now())
  quantity Int
  remaining Int
  targetRaffleId String?
  targetRaffle Raffle? @relation(fields:[targetRaffleId],references:[id],onDelete:Restrict)
  revokedAt DateTime?
  createdAt DateTime @default(now())
  uses FreeTicketUse[]
  @@index([userId, revokedAt, remaining])
}
model FreeTicketUse {
  id String @id @default(cuid())
  benefitId String
  benefit FreeTicketBenefit @relation(fields:[benefitId],references:[id],onDelete:Restrict)
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  quantity Int
  restoredAt DateTime?
  @@unique([benefitId,orderId])
}
enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}
enum OrderEmailKind {
  REFUND_REQUEST_RECEIVED
  REFUND_REQUEST_APPROVED
  REFUND_REQUEST_REJECTED
  RAFFLE_WINNER
  PURCHASE_CONFIRMED
  PURCHASE_REJECTED
  REFUND_REQUESTED
  REFUND_COMPLETED
}
model PurchaseEmail {
  id String @id @default(cuid())
  orderId String
  eventKey String @unique
  kind OrderEmailKind @default(PURCHASE_CONFIRMED)
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  toEmail String
  payload Json
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([orderId])
}
model Allocation {
  id String @id @default(cuid())
  raffleId String
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Restrict)
  number Int
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@unique([raffleId, number])
}
model Receipt {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  storageKey String @unique
  mimeType String
  size Int
  sha256 String
  uploadedAt DateTime @default(now())
  deleteAfter DateTime
  deletedAt DateTime?
  @@index([deleteAfter, deletedAt])
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  actorRole Role?
  action String
  entityId String
  detail Json?
  createdAt DateTime @default(now())
}
model EmailVerification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  email String
  expiresAt DateTime
  consumedAt DateTime?
  status EmailStatus @default(PENDING)
  attempts Int @default(0)
  lockedAt DateTime?
  nextAttemptAt DateTime @default(now())
  sentAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
